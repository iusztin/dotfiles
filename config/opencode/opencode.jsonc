{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "plugin": ["opencode-websearch"],

  "default_agent": "plan",

  "small_model": "openai/gpt-5.4-mini",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
    },

    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
    },

    "explore": {
      "model": "openai/gpt-5.6-terra",
    }
  }
}
