{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",

  "agent": {
    "build": {
      "mode": "primary",
      // gpt-5.4: more premium
      // gpt-5.3-codex: best value
      "model": "openai/gpt-5.4",
      // "high": quality
      // "medium": cost efficient
      "reasoningEffort": "medium",
      // "medium": quality
      // "low": cost efficient
      "textVerbosity": "low",
    },

    "plan": {
      "mode": "primary",
      // gpt-5.5: best but expensive
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      // "high": quality
      // "medium": cost efficient
      "textVerbosity": "medium",
    },

    "general": {
      "mode": "subagent",
      // opencode-go/kimi-k2.6: better
      // opencode-go/qwen3.6-plus: recommended by ChatGPT for prompt generation
      // opencode-go/deepseek-v4-pro: cost efficient
      "model": "opencode-go/kimi-k2.6",
    },

    "explore": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
    },

    "scout": {
      "mode": "subagent",
      // opencode-go/kimi-k2.6: better
      // opencode-go/deepseek-v4-pro: cost efficient
      "model": "opencode-go/deepseek-v4-pro",
    },

    "compaction": {
      "model": "opencode-go/qwen3.6-plus",
    },

    "summary": {
      "model": "opencode-go/qwen3.6-plus",
    },

    "title": {
      "model": "opencode-go/deepseek-v4-flash",
    }
  }
}
