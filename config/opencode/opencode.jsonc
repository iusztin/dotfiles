{
  "$schema": "https://opencode.ai/config.json",

  "plugin": ["opencode-websearch"],

  "default_agent": "plan",

  "agent": {
    "build": {
      "mode": "primary",
      // gpt-5.4: more premium
      // gpt-5.3-codex: best value
      "model": "openai/gpt-5.4",
      // "high": quality
      // "medium": cost efficient
      "reasoningEffort": "medium",
      // "medium": quality
      // "low": cost efficient
      "textVerbosity": "low",
    },

    "plan": {
      "mode": "primary",
      // gpt-5.5: best but expensive
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      // "high": quality
      // "medium": cost efficient
      "textVerbosity": "medium",
    },

    // `general`: Use parent subagent. Used mostly for splitting work. Not just research.

    "explore": {
      "mode": "subagent",
      // opencode-go/mimo-v2.5-pro: lowest hallucination rate, 1M context
      // opencode-go/minimax-m2.7: good hallucination rate, very cheap
      // opencode-go/deepseek-v4-flash: cheapest, but high hallucination rate
      // openai/gpt-5.4-mini: only suitable alternative for OpenAI
      "model": "opencode-go/minimax-m2.7",
    },

    "scout": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5-pro",
    },

    "compaction": {
      "model": "opencode-go/qwen3.6-plus",
    },

    "summary": {
      "model": "opencode-go/qwen3.6-plus",
    },

    "title": {
      "model": "opencode-go/deepseek-v4-flash",
    }
  }
}
